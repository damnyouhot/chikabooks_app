# ── [CHIKA_WEB_AUTO_LOGIN: BEGIN] ────────────────────────────────────
# 임시 기능용 예시 env. 원복 시 이 파일째 삭제. (검색 키워드: CHIKA_WEB_AUTO_LOGIN)
#
# 프로젝트 루트에 복사한 뒤 값만 채우세요 (파일명: .chika_web_login.env — gitignore 됨)
#
#   cp tools/chika_web_login.env.example .chika_web_login.env
#
# 비밀번호에 공백·특수문자가 있으면 작은따옴표로 감싸세요.
# 예: CHIKA_WEB_AUTO_PASSWORD='my p@ss'

CHIKA_WEB_AUTO_EMAIL=
CHIKA_WEB_AUTO_PASSWORD=

# 우측 치과(공고자) 카드 1-click 입장용 테스트 자격 증명. (선택)
# 비워두면 우측 카드의 테스트 버튼이 렌더되지 않음.
# 채워두면 /login 우측 카드 하단에 "테스트 치과 계정으로 입장" 버튼이 떠서
# 한 클릭으로 공고 작성 흐름(`/post-job/input`)으로 진입 가능.
CHIKA_WEB_AUTO_CLINIC_EMAIL=
CHIKA_WEB_AUTO_CLINIC_PASSWORD=

# 다른 Firebase 세션이 남아 있을 때 로그아웃 후 위 계정으로 다시 로그인하려면 1
CHIKA_WEB_AUTO_REPLACE_SESSION=1

# 부팅 시 자동 sign-in 을 건너뛰고 /login 을 먼저 보고 싶으면 0(=false).
# 1(=true) 이거나 미설정이면 사이트 진입 즉시 자동 로그인.
# 0 으로 두면 /login 좌측 카드 하단에 "테스트 계정으로 1-click 입장" 버튼이 떠서
# 한 클릭으로 공고 보드로 진입할 수 있고, 우측 공고(치과) 카드도 자유롭게 테스트 가능.
CHIKA_WEB_AUTO_LOGIN_ON_BOOT=1
# ── [CHIKA_WEB_AUTO_LOGIN: END] ──────────────────────────────────────
